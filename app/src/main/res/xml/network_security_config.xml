<?xml version="1.0" encoding="utf-8"?>
<!--
  Парсер на VPS пока отдаёт API по обычному http:// (см. freelance_parser
  README → "API для мобильного приложения") — порт защищён только токеном,
  TLS перед ним ещё не поднят. Без этого файла Android 9+ молча режет любой
  cleartext-трафик, и запросы к серверу не уйдут вообще.

  Адрес сервера — не константа, а то, что вводится в Настройках приложения,
  поэтому белый список доменов здесь не годится (сменили IP — трафик снова
  режется без объяснения). Разрешаем cleartext глобально: угроза — не «кто-то
  подменит облачный сервис», а собственный VPS с одним пользователем и
  токеном в заголовке. Когда на сервере появится TLS (Caddy/Let's Encrypt),
  это стоит сузить обратно до конкретного домена.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
